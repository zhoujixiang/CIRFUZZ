# Python cache
__pycache__/
*.pyc

# IDE / tools
.vscode/
.idea/

# Generated dataset outputs (written by dataset_init.py into the dataset root,
# next to the input -d directory — not under this repo). Root-anchored so the
# vendored FRNet tree under third/FRNet/frnet/ is NOT ignored.
/dataset/
/semantic/
/v2x_dataset/

# FRNet vendored repo: build/runtime artifacts only
third/FRNet/work_dirs/
third/FRNet/data/
third/FRNet/*.egg-info/

# Large data
*.zip
*.npy
*.pkl
*.h5
